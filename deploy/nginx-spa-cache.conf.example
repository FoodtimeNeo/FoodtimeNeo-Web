# Merge into the existing HTTPS server; keep /api/ proxy, TLS and all security headers.
# A location-level add_header overrides inherited headers on some Nginx versions:
# repeat/include the existing security headers in EVERY location below.
location = /version.json {
    include /etc/nginx/snippets/foodtime-security-headers.conf;
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
}
location = /sw.js {
    include /etc/nginx/snippets/foodtime-security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
}
location /assets/ {
    include /etc/nginx/snippets/foodtime-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}
location / {
    include /etc/nginx/snippets/foodtime-security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
}
